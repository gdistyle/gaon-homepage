{
  "name": "gaonlab",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "BOOKING", "class_name": "Booking" }, { "name": "ACCOUNTS", "class_name": "Accounts" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Booking"] }, { "tag": "v3", "new_sqlite_classes": ["Accounts"] }]
}
